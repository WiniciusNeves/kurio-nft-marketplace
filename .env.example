# Opcional: todos os valores abaixo já são os padrões do app.
# Ativa a camada de mocks (MSW REST + Socket.IO). Obrigatório enquanto não há backend real.
VITE_ENABLE_MOCKS=true
# Base das chamadas REST (interceptadas pelo MSW)
VITE_API_URL=/api
# URL do servidor Socket.IO (interceptada pelo MSW via @mswjs/socket.io-binding)
VITE_SOCKET_URL=wss://realtime.kurio.mock
# Cenário inicial dos mocks (ver README > Cenários)
VITE_MOCK_SCENARIO=default
# Exibe o painel de mocks (botão flutuante) — útil na demo
VITE_SHOW_MOCK_PANEL=true
# Timeout das requisições REST (ms)
VITE_HTTP_TIMEOUT_MS=10000
